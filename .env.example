# TradingBackend WebSocket (required for purchase recording + onboarding checks)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Optional explicit backend HTTP origin (defaults from NEXT_PUBLIC_WS_URL)
# TRADING_BACKEND_URL=http://localhost:8000

# ClickFunnels checkout / order-form URL (required for landing purchase CTAs)
NEXT_PUBLIC_CLICKFUNNELS_URL=https://checkout.enterthevault.co/

# Make.com scenario webhook — receives purchase events from /api/webhooks/clickfunnels
MAKE_WEBHOOK_URL=https://hook.us2.make.com/fu68ssftfj2ivpu3kqgh17wzwsci7gmv

# Optional: require this secret on ClickFunnels webhook calls (header x-webhook-secret or ?secret=)
# CLICKFUNNELS_WEBHOOK_SECRET=
